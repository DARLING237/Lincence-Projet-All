{
  "name": "barrestaurant-backend",
  "version": "2.0.0",
  "description": "API backend pour la gestion de bar/restaurant - BarResto",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "migrate": "node scripts/run-migration.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/backup-db.js --restore",
    "hash-passwords": "node scripts/hash-passwords.js",
    "add-first-login": "node scripts/add-first-login.js",
    "add-last-seen": "node scripts/add-last-seen.js",
