# ====================================================
# BarResto - Fichier .env Exemple
# Copiez ce fichier sous le nom '.env' dans le dossier 'backend'
# et configurez vos propres variables locales.
# ====================================================

# ==== DATABASE (MySQL / MariaDB via WAMP ou autre) ====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=barrestaurant_db
DB_PORT=3306

# ==== JWT / AUTH ====
# IMPORTANT: Utilisez un secret très long et aléatoire en production !
JWT_SECRET=generer_un_secret_jwt_tres_long_et_securise
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ==== SERVER ====
PORT=3000
NODE_ENV=development

# ==== CAMPay (Intégration Paiements Mobiles - Optionnel) ====
CAMPAY_ENV=votre_campay_env_key
CAMPAY_USERNAME=votre_campay_username
CAMPAY_PASSWORD=votre_campay_password

# ==== UPLOADS ====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
