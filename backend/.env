/**
 * BarResto - Backend Configuration
 * Fichier .env - Variables d'environnement
 */

# ==== DATABASE ====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=barrestaurant_db
DB_PORT=3306

# ==== JWT / AUTH ====
JWT_SECRET=change_moi_secret_jwt_tres_long_et_complexe_2025
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ==== SERVER ====
PORT=3000
NODE_ENV=development

# ==== CAMPay (Optionnel) ====
CAMPAY_ENV=demo
CAMPAY_USERNAME=
CAMPAY_PASSWORD=

# ==== UPLOADS ====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880